{
  "name": "dsh-github-message",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) plugin: read-only GitHub polling that turns review requests, new issues and @mentions into my-superagent/v1 signals.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xbzbing/dsh-github-message.git"
  },
  "homepage": "https://github.com/xbzbing/dsh-github-message#readme",
  "bugs": {
    "url": "https://github.com/xbzbing/dsh-github-message/issues"
  },
  "icon": "./assets/icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets/icon.svg",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "github",
    "notifications",
    "code-review",
    "superagent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "assert-pack": "node scripts/assert-pack.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
